# Provider: anthropic (default) or openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Strong model for planning/drafting, cheap model for checks/extraction/summaries
LLM_MODEL_WRITER=claude-opus-5-5
LLM_MODEL_CHEAP=claude-haiku-4-5
LLM_EFFORT_WRITER=medium

# Limits (see serial_writer/config.py for all knobs)
EPISODE_COST_CAP_USD=0.25
RUN_BUDGET_USD=10
MAX_REVISIONS=2
CONTEXT_BUDGET_TOKENS=12000
RUBRIC_PASS_MEAN=3.5
REPETITION_THRESHOLD=0.88
SKIP_JUDGE_IF_HARD_PASS=0
EMBEDDINGS=auto              # auto | openai | local
ANTHROPIC_FALLBACKS=1        # server-side refusal fallbacks for Opus/Sonnet 5.x (auto-disabled if unsupported)
